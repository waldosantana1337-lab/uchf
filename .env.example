# YouChef Environment Configuration

# -----------------------------------------------------------------------------
# 1. Core AI Engine (REQUIRED)
# -----------------------------------------------------------------------------
# Description: API Key for Google Gemini API via @google/genai SDK.
# Scope: Server-side ONLY (never expose on client side or in HTML/Vite bundles).
# Models utilized:
#   - gemini-3.8-flash (Recipe generation, receipt OCR parsing, fridge inventory scan, dish critique)
#   - gemini-3.1-flash-lite-image (Food photography generation with ingredient adherence)
# Where to obtain: https://aistudio.google.com/app/apikey or Google Cloud Console.
# Default in AI Studio: Pre-injected by runtime into process.env.GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 2. Server Runtime Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# Port for the Node.js Express server to listen on.
# Default in AI Studio / local dev: 3000
PORT=3000

# Node Environment: 'development' | 'production'
# Default: 'development' (uses Vite middleware in dev, serves /dist in production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# 3. Client & Analytics Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# Optional analytics tracker ID. Must be prefixed with VITE_ to be exposed to client.
# VITE_ANALYTICS_ID=UA-XXXXX-Y
